+def bounded_component(gpu, terminal_index=None, evidence=None, required=False):
+    """Keep an explicitly verified terminal GPU event, without rewriting it."""
+    if terminal_index is None:
+        if required:
+            raise ValueError("Thor component analysis requires --terminal-index and --boundary-evidence; a full request is not a component boundary")
+        return gpu
+    if not evidence or not evidence.strip():
+        raise ValueError("--boundary-evidence is required for a terminal index")
+    if terminal_index < 0 or terminal_index >= len(gpu):
+        raise ValueError("--terminal-index is outside the selected GPU kernel list")
+    return gpu[:terminal_index + 1]
